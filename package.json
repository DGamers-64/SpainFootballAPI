{
  "name": "spainfootballapi",
  "version": "0.0.0",
  "description": "API for spanish football with full coverage",
  "keywords": [
    "football",
    "api",
    "spain",
    "full-coverage"
  ],
  "homepage": "https://github.com/DGamers-64/SpainFootballAPI#readme",
  "bugs": {
    "url": "https://github.com/DGamers-64/SpainFootballAPI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DGamers-64/SpainFootballAPI.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "xLune64",
  "type": "module",
  "main": "api.js",
  "scripts": {
    "start": "node --watch --env-file=.env api.js",
    "live-client": "npx browser-sync start --proxy \"http://localhost:6123\" --files \"public/**/*\"",
    "all": "concurrently \"node --run start\" \"node --run live-client\""
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1"
  }
}
